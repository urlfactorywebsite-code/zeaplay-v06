{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListMediaPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::zea-play-attachments"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "media/*",
            "avatars/*"
          ]
        }
      }
    },
    {
      "Sid": "MediaObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::zea-play-attachments/media/*",
        "arn:aws:s3:::zea-play-attachments/avatars/*"
      ]
    }
  ]
}
