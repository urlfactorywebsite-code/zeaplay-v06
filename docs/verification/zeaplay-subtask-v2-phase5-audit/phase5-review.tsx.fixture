import React from 'react';
import {createRoot} from 'react-dom/client';
import {MemoryRouter} from 'react-router-dom';
import {QueryClient,QueryClientProvider} from '@tanstack/react-query';
import {AuthProvider,ThemeProvider} from '../hooks/useAuth';
import {LoadingProvider} from '../components/loading/LoadingProvider';
import {ToastProvider} from '../hooks/useToast';
import TaskDetailModal from '../components/TaskDetailModal';
import api from '../services/mockApi';
import {storeTokens} from '../services/tokenStorage';
import '../index.css';
const user={id:'fixture-owner',name:'Phase 5 Reviewer',email:'reviewer@example.test',role:'owner',timezone:'Asia/Kolkata',status:'active',points:100,avatarUrl:null};
storeTokens('synthetic-phase5-only','synthetic-refresh');
const task:any={id:'fixture-task',title:'Phase 5 review task',description:'Existing task description',createdBy:user.id,createdAt:'2026-11-02T10:00:00Z',updatedAt:'2026-11-02T11:00:00Z',dueAt:'2026-11-05T12:00:00Z',status:'TODO',priority:'HIGH',team:'General',category:'General',assignedTo:[user.id],taskGroupId:'group',subtasks:[],recurrenceRule:'NONE',recurringTaskId:null,clarityRating:null,attachments:[],estimatedHours:4,tags:[]};
const state:any={calls:[],renders:{History:0,Subtasks:0},fail:false,hold:0,empty:false};
api.getCurrentUser=async()=>user as any;
api.getTask=async()=>task;
api.getTaskGroup=async()=>[task];
api.getComments=async()=>[];
api.listTaskTransferRequests=async()=>[];
const children=Array.from({length:105},(_,i)=>({kind:'subtask',id:`child-${i}`,name:`Subtask ${String(i+1).padStart(3,'0')}`,assignee:{id:user.id,name:user.name},effective_priority:i===1?'LOW':'HIGH',priority_inherited:i!==1,planned_start_date:'2026-11-02',planned_end_date:'2026-11-03',actual_start_at:i===0?'2026-11-02T10:00:00Z':null,actual_end_at:i===0?'2026-11-02T11:00:00Z':null,status:i===0?'COMPLETED':'TODO',completed:i===0,deleted_at:null,created_at:'2026-11-02T10:00:00Z',policy_version:'subtask-additional-v1',additional_base_value:i===0?0:30,available_base:i===0?0:30,earned:0,components:{BASE:0,BONUS:0,PENALTY:0,REVERSAL:0},productive_seconds:i===0?3600:0,elapsed_seconds:i===0?7200:0}));
children[1].components={BASE:30,BONUS:15,PENALTY:0,REVERSAL:-45};children[2].components={BASE:30,BONUS:0,PENALTY:-15,REVERSAL:0};children[2].completed=true;children[2].status='COMPLETED';children[2].earned=15;children[2].available_base=0;
const events=Array.from({length:60},(_,i)=>({kind:'event',id:`event-${i}`,source:'audit_event',event_type:i===0?'subtask.created':'subtask.updated',timestamp:`2026-11-02T${String(10+Math.floor(i/60)).padStart(2,'0')}:${String(i%60).padStart(2,'0')}:00Z`,actor:{id:user.id,name:user.name},subtask_id:null,channel:'workflow',previous_status:i===0?null:'TODO',new_status:i===0?'TODO':'IN_PROGRESS',duration_seconds:i===59?null:60,before:i===0?null:{status:'TODO'},after:{status:'IN_PROGRESS'},details:i===0?{note:'Safe literal <img src=x onerror=alert(1)>'}:{}}));
api.getTaskInformation=async(id,options,signal)=>{state.calls.push({...options});await new Promise((resolve,reject)=>{const timer=setTimeout(resolve,state.hold||80);signal?.addEventListener('abort',()=>{clearTimeout(timer);reject(new DOMException('Aborted','AbortError'));},{once:true});});if(state.fail)throw Error('Synthetic authorized read unavailable');const result:any={viewer_id:state.viewerId||user.id,task_id:id,section:options.section,as_of:new Date().toISOString(),overview:null,points:null,items:[],total:0,page:options.page,page_size:25,created_at:task.createdAt,coverage:'Recorded history only. Missing legacy transitions are not reconstructed.'};
if(options.section==='overview')result.overview={id,name:task.title,description:task.description,team:task.team,project:null,creator:{id:user.id,name:user.name},assignees:[{id:user.id,name:user.name}],priority:task.priority,status:task.status,created_at:task.createdAt,updated_at:task.updatedAt,assigned_at:null,planned_start_date:null,planned_end_date:null,actual_start_at:null,actual_end_at:null,estimated_hours:4,productive_seconds:3600,elapsed_seconds:7200,due_at:task.dueAt,completed_at:null,approval_status:'NONE',approval_required:false,limitations:['Parent tasks have no project, planned-date or manual actual-time fields in this schema.']};
if(options.section==='points')result.points={main_base_value:30,main_earned:null,main_recorded_net:state.mainAdjustment||0,main_recorded_components:{BASE:0,BONUS:0,PENALTY:0,ADJUSTMENT:state.mainAdjustment||0,REVERSAL:0},subtask_components:{BASE:60,BONUS:15,PENALTY:-15,ADJUSTMENT:0,REVERSAL:-45},subtask_base_capacity:3120,subtask_available_base:3090,subtask_earned:15,components:{BASE:60,BONUS:15,PENALTY:-15,ADJUSTMENT:state.mainAdjustment||0,REVERSAL:-45},verified_net_earned:15+(state.mainAdjustment||0),total_net_earned:null,recipients:[{id:user.id,name:user.name,net:15+(state.mainAdjustment||0),main_net:state.mainAdjustment||0,subtask_net:15,components:{BASE:60,BONUS:15,PENALTY:-15,REVERSAL:-45}}],coverage:'Verified task-linked ledger only. Main-task payout history is incomplete; full task net is unknown.'};
if(['timeline','activity','subtasks'].includes(options.section)){let all=state.empty?[]:options.section==='subtasks'?children.filter(c=>c.name.toLowerCase().includes((options.search||'').toLowerCase())):options.subtask_id?events.slice(0,state.childHistoryCount??2):events;result.total=all.length;result.items=all.slice((options.page-1)*25,options.page*25);}return JSON.parse(JSON.stringify(result));};
(window as any).__phase5={state,user,children,events};
function App(){const [open,setOpen]=React.useState(true);return <><button onClick={()=>setOpen(true)}>Open task details</button><TaskDetailModal taskId={task.id} isOpen={open} initialTask={task} onClose={()=>setOpen(false)} usersMap={new Map([[user.id,user as any]])}/></>}
createRoot(document.getElementById('root')!).render(<MemoryRouter><QueryClientProvider client={new QueryClient()}><ThemeProvider><LoadingProvider><AuthProvider><ToastProvider><App/></ToastProvider></AuthProvider></LoadingProvider></ThemeProvider></QueryClientProvider></MemoryRouter>);
