import React from 'react';
import {createRoot} from 'react-dom/client';
import {MemoryRouter} from 'react-router-dom';
import {QueryClient,QueryClientProvider} from '@tanstack/react-query';
import {AuthProvider,ThemeProvider,SearchProvider} from '../hooks/useAuth';
import {NavigationProvider} from '../hooks/useNavigation';
import {LoadingProvider} from '../components/loading/LoadingProvider';
import Header from '../components/Header';
import WorkloadAlertSettings from '../components/WorkloadAlertSettings';
import api from '../services/mockApi';
import {storeTokens} from '../services/tokenStorage';
import {SETTINGS_TABS} from '../utils/settingsNavigation';
import {TASK_TABS} from '../utils/taskNavigation';
import '../index.css';
const user:any={id:'phase6-user',name:'Phase 6 Reviewer',email:'reviewer@example.test',role:'owner',timezone:'Asia/Kolkata',status:'active',points:100,avatarUrl:null};
storeTokens('synthetic-phase6-only','synthetic-refresh');
const state:any={calls:0,shown:[],sounds:0,prompts:0,sockets:[],saved:[],opened:[],fail:false,delay:0,quiet:false,push:true,sound:false,unread:151,items:[{id:'initial',userId:user.id,type:'TASK_UPDATED',alertKind:'task_updated',title:'Existing task alert',message:'Historical notification',isRead:false,relatedTaskId:'task-1',relatedRewardId:null,createdAt:'2026-11-02T10:00:00Z'}]};
class FakeNotification {static permission='denied';static requestPermission=async()=>{state.prompts++;return this.permission};onclick:any;constructor(title:any,options:any){state.shown.push({title,...options})}close(){}}
Object.defineProperty(window,'Notification',{value:FakeNotification,configurable:true});
class FakeAudio {currentTime=0;destination={};constructor(){state.sounds++}createOscillator(){return {frequency:{value:0},connect(){},start(){},stop(){},onended:null}}createGain(){return {gain:{value:0},connect(){}}}close(){return Promise.resolve()}}
Object.defineProperty(window,'AudioContext',{value:FakeAudio,configurable:true});
class FakeSocket extends EventTarget {static OPEN=1;static CONNECTING=0;static CLOSED=3;readyState=0;constructor(url:any){super();state.sockets.push(this);setTimeout(()=>{if(this.readyState===0){this.readyState=1;this.dispatchEvent(new Event('open'))}},20)}send(){}close(){this.readyState=3;this.dispatchEvent(new Event('close'))}}
Object.defineProperty(window,'WebSocket',{value:FakeSocket,configurable:true});
api.getCurrentUser=async()=>user;
const page=(id:string,route:string)=>({id,route,title:id,label:id,access:'allowed',visible:true,enabled:true,hidden:false,permittedRoles:['owner'],allowedRoles:['owner'],navigationLocation:'sidebar'});
api.getNavigationPolicy=async()=>({tenantId:'synthetic-tenant',version:1,roles:['owner'],pages:[page('settings','/settings'),...SETTINGS_TABS.map(t=>page('settings.'+t.key,t.path)),...TASK_TABS.map(t=>page(t.pageId,t.path))]}) as any;
api.getNotificationInbox=async()=>{state.calls++;const result={userId:user.id,items:JSON.parse(JSON.stringify(state.items)),unreadCount:state.unread,soundEnabled:state.sound,pushEnabled:state.push,quiet:state.quiet};if(state.delay)await new Promise(r=>setTimeout(r,state.delay));if(state.fail)throw Error('synthetic offline');return result};
api.markNotificationAsRead=async(_u,id)=>{const n=state.items.find(n=>n.id===id);if(n&&!n.isRead){n.isRead=true;state.unread--}};
api.deleteNotification=async id=>{const n=state.items.find(n=>n.id===id);if(n&&!n.isRead)state.unread--;state.items=state.items.filter(n=>n.id!==id)};
api.getTaskActivity=async()=>({user_id:user.id,user_name:user.name,read_only:false,server_now:new Date().toISOString(),timezone:user.timezone,active_count:5,limit:5,contexts:Array.from({length:5},(_,i)=>({id:'context-'+i,task_id:'task-'+i,subtask_id:null,task_title:'Work task '+(i+1),subtask_title:null,priority:'HIGH',status:'RUNNING',slot:i+1,version:1,elapsed_seconds:600,elapsed_ms:600000,resumed_at:new Date().toISOString(),productive_seconds:300,subtask_productive_seconds:null,subtask_elapsed_seconds:null,actual_start_at:null,actual_end_at:null,deadline:'2026-11-05T12:00:00Z',task_status:'IN_PROGRESS',subtask_status:null,can_start:true})),workload:{period_start:'2026-11-02T00:00:00Z',period_end:'2026-11-03T00:00:00Z',manual_seconds:3600,overlap_seconds:0,estimated_remaining_seconds:7200,unestimated_tasks:0,capacity_seconds:14400,remaining_capacity_seconds:3600,overtime_threshold_seconds:0,overtime_seconds:0,capacity_note:null,near_deadline:[],overdue_tasks:[],overdue_subtasks:[],near_deadline_window_hours:6}});
api.getTasks=async()=>[];api.getUsers=async()=>[user];
function App(){const [mounted,setMounted]=React.useState(true);const [pref,setPref]=React.useState<any>({module:'tasks',pushEnabled:true,nearDeadlineHours:24,soundEnabled:false,productiveCapacityHours:null,overtimeThresholdMinutes:0,quietStart:null,quietEnd:null});state.toggle=setMounted;return <>{mounted&&<Header onRewardNotificationClick={()=>undefined} onNotificationClick={id=>state.opened.push(id)}/>}<main style={{padding:24,marginTop:100}}><WorkloadAlertSettings preference={pref} onSave={async value=>{state.saved.push(value);setPref(value)}}/></main></>}
(window as any).__phase6={state,user,rotateSession:()=>{storeTokens('synthetic-phase6-rotated','synthetic-refresh');window.dispatchEvent(new CustomEvent('user:profile-updated',{detail:{...user}}))},changeRole:()=>window.dispatchEvent(new CustomEvent('user:profile-updated',{detail:{...user,role:'user'}})),notify:()=>window.dispatchEvent(new Event('zea:notifications-changed')),emit:()=>state.sockets.filter(s=>s.readyState===1).forEach(s=>s.dispatchEvent(new MessageEvent('message',{data:JSON.stringify({type:'notifications.changed',user_id:user.id})}))),permission:(value)=>{FakeNotification.permission=value}};
createRoot(document.getElementById('root')!).render(<React.StrictMode><MemoryRouter><QueryClientProvider client={new QueryClient()}><ThemeProvider><LoadingProvider><AuthProvider><SearchProvider><NavigationProvider><App/></NavigationProvider></SearchProvider></AuthProvider></LoadingProvider></ThemeProvider></QueryClientProvider></MemoryRouter></React.StrictMode>);
