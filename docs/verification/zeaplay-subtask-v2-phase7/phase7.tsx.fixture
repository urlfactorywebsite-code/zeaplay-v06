import React from 'react';
import {createRoot} from 'react-dom/client';
import {MemoryRouter} from 'react-router-dom';
import {QueryClient,QueryClientProvider} from '@tanstack/react-query';
import {AuthProvider,ThemeProvider,SearchProvider} from '../hooks/useAuth';
import {NavigationProvider} from '../hooks/useNavigation';
import {LoadingProvider} from '../components/loading/LoadingProvider';
import {ToastProvider} from '../hooks/useToast';
import TaskDetailModal from '../components/TaskDetailModal';
import Header from '../components/Header';
import api from '../services/mockApi';
import {storeTokens} from '../services/tokenStorage';
import '../index.css';

async function boot() {
  const response = await fetch('/api/auth/login', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:'owner@example.com',password:'phase7-synthetic-password'})});
  if (!response.ok) throw Error('Synthetic fixture login failed');
  const session = await response.json();
  storeTokens(session.token.access_token, session.token.refresh_token);
  const headers = {'Content-Type':'application/json',Authorization:`Bearer ${session.token.access_token}`};
  const policy = await (await fetch('/api/config/subtask-rewards',{headers})).json();
  if (!policy.enabled) await fetch('/api/config/subtask-rewards',{method:'PATCH',headers,body:JSON.stringify({enabled:true,expected_version:policy.version})});
  const raw = await fetch('/api/tasks',{method:'POST',headers,body:JSON.stringify({title:'Phase 7 browser task',team:'IT Support',priority:'HIGH',assigned_to_id:'owner',follower_ids:['watcher'],subtasks:[{title:'First zero reward',planned_start_date:'2026-11-02',planned_end_date:'2026-11-03'},{title:'Additional reward',planned_start_date:'2026-11-02',planned_end_date:'2026-11-03'}]})});
  if(!raw.ok) throw Error(await raw.text());
  const [created] = await raw.json();
  const task = await api.getTask(created.id);
  const user = await api.getCurrentUser();
  if(!user || !task) throw Error('Synthetic fixture identity or task missing');
  (window as any).__phase7 = {taskId:task.id,headers};
  function App(){const [open,setOpen]=React.useState(true);return <><Header onRewardNotificationClick={()=>undefined} onNotificationClick={()=>setOpen(true)}/><main style={{padding:24,marginTop:100}}><button onClick={()=>setOpen(true)}>Open task details</button></main><TaskDetailModal taskId={task.id} isOpen={open} initialTask={task} onClose={()=>setOpen(false)} usersMap={new Map([[user.id,user]])}/></>}
  createRoot(document.getElementById('root')!).render(<React.StrictMode><MemoryRouter><QueryClientProvider client={new QueryClient()}><ThemeProvider><LoadingProvider><AuthProvider><SearchProvider><NavigationProvider><ToastProvider><App/></ToastProvider></NavigationProvider></SearchProvider></AuthProvider></LoadingProvider></ThemeProvider></QueryClientProvider></MemoryRouter></React.StrictMode>);
}
boot().catch(error=>{document.getElementById('root')!.textContent=String(error);throw error;});
